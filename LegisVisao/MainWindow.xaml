<Window x:Class="LegisVisao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LegisVisao"
        xmlns:converters="clr-namespace:LegisVisao.Converters"
        mc:Ignorable="d"
        Title="LegisVisão" Height="450" Width="800">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Request type selector -->
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center">
            Tipo de requisição:
        </TextBlock>
        <ComboBox x:Name="RequestTypeComboBox" 
                  Grid.Row="0" Grid.Column="1" 
                  Margin="5" 
                  IsEditable="True" 
                  IsTextSearchEnabled="True" />

        <!-- Number of results -->
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center">
            Quantidade de resultados:
        </TextBlock>
        <TextBox x:Name="ResultsCountTextBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Margin="5" Text="100" />

        <!-- Page index -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center">
            Índice da página:
        </TextBlock>
        <TextBox x:Name="PageIndexTextBox" 
                 Grid.Row="2" Grid.Column="1" 
                 Margin="5" Text="1" />

        <!-- Fetch button - SEM o conversor inverso -->
        <Button x:Name="FetchButton" 
                IsEnabled="{Binding IsFetchButtonEnabled, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="3" Grid.ColumnSpan="2" 
                Margin="5" Height="30" 
                Content="Buscar" 
                HorizontalAlignment="Center" 
                Width="100" 
                Click="FetchButton_Click"/>

        <!-- Results list -->
        <ListBox x:Name="ResultsListBox" 
                 Grid.Row="4" Grid.ColumnSpan="2" 
                 Margin="5" 
                 ScrollViewer.CanContentScroll="True"/>
    </Grid>
</Window>